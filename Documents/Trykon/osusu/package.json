{
  "name": "osusu",
  "version": "0.1.0",
  "description": "Starter osusu project",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint .",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "backup:sqlite": "bash scripts/backup-database.sh sqlite manual",
    "backup:postgres": "bash scripts/backup-database.sh postgres manual",
    "backup:daily": "bash scripts/backup-database.sh postgres daily",
    "load-test": "artillery run load-test.yml",
    "security-audit": "bash scripts/security-audit.sh",
    "migrate:sqlite-to-postgres": "bash scripts/migrate-sqlite-to-postgres.sh",
    "setup:ssl": "bash scripts/setup-ssl.sh",
    "setup:cron": "bash scripts/setup-cron-backup.sh postgres daily"
  },
  "dependencies": {
    "artillery": "^2.0.30",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-force-https": "^1.0.0",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "lowdb": "^5.0.0",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.4",
    "owasp-dependency-check": "^1.0.1",
    "pg": "^8.20.0",
    "pg-migrate": "^2.0.1",
    "sqlite3": "^6.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "jest": "^29.6.1",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "author": "",
  "license": "MIT"
}
