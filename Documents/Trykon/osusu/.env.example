# ==================== SERVER CONFIGURATION ====================
PORT=5000
NODE_ENV=production
LOG_LEVEL=info
APP_URL=https://yourdomain.com

# CORS Configuration
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com,https://admin.yourdomain.com

# ==================== JWT CONFIGURATION ====================
JWT_SECRET=your_super_secret_key_minimum_32_characters_change_in_production
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_EXPIRES_IN=7d

# ==================== DATABASE CONFIGURATION ====================
# Type: sqlite (local) or postgresql (production recommended)
DB_TYPE=postgresql

# Option 1: PostgreSQL via connection string
DATABASE_URL=postgresql://username:password@hostname:5432/databasename

# Option 2: PostgreSQL via individual components
DB_HOST=localhost
DB_PORT=5432
DB_NAME=osusu
DB_USER=postgres
DB_PASSWORD=secure_password_here

# Option 3: SQLite (for local development only)
# DB_TYPE=sqlite
# DB_PATH=./src/db.sqlite

# ==================== SSL/TLS CONFIGURATION ====================
# Let's Encrypt (Production)
SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem
FORCE_HTTPS=true

# Or Self-Signed (Development)
# SSL_CERT_PATH=./config/certs/cert.pem
# SSL_KEY_PATH=./config/certs/key.pem
# FORCE_HTTPS=false

# ==================== EMAIL SERVICE CONFIGURATION ====================
# Service type: sendgrid | mailgun | smtp | ethereal
EMAIL_SERVICE=sendgrid
EMAIL_FROM=noreply@yourdomain.com

# SendGrid
EMAIL_API_KEY=SG.xxx_your_sendgrid_api_key_xxx

# Mailgun
# EMAIL_SERVICE=mailgun
# MAILGUN_DOMAIN=yourdomain.mailgun.org
# EMAIL_API_KEY=xxx_your_mailgun_api_key_xxx

# Generic SMTP
# EMAIL_SERVICE=smtp
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=your_email@gmail.com
# EMAIL_SMTP_PASSWORD=your_app_password

# ==================== BACKUP CONFIGURATION ====================
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

# AWS S3 (Optional)
AWS_S3_BUCKET=osusu-backups
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# ==================== MONITORING & LOGGING ====================
# Sentry (Error Tracking)
SENTRY_DSN=https://key@sentry.io/project-id
SENTRY_ENVIRONMENT=production

# New Relic (APM)
NEW_RELIC_LICENSE_KEY=your_license_key
NEW_RELIC_APP_NAME=osusu

# Datadog (Metrics & APM)
DATADOG_API_KEY=your_api_key
DATADOG_APP_KEY=your_app_key
DATADOG_SITE=datadoghq.com
DD_SERVICE=osusu
DD_ENV=production

# ==================== CACHE CONFIGURATION ====================
# Redis (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# ==================== SECURITY CONFIGURATION ====================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=300000
FINANCIAL_RATE_LIMIT_MAX=10
FINANCIAL_RATE_LIMIT_WINDOW_MS=3600000
SENTRY_DSN=

# Email Provider (optional - for password resets)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=

# Payment Processing (optional - Stripe for future fee collection)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Backup Configuration (optional)
DATABASE_BACKUP_ENABLED=false
DATABASE_BACKUP_FREQUENCY=daily
DATABASE_BACKUP_PATH=./backups

# Feature Flags
ENABLE_OAUTH=false
ENABLE_PAYMENT_COLLECTION=false
ENABLE_AUDIT_LOGGING=true
